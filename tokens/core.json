{
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": "system-ui, sans-serif"
    },
    "size": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "sizeLg": {
      "$type": "dimension",
      "$value": "1.25rem"
    }
  },
  "layout": {
    "wide": {
      "$type": "dimension",
      "$value": "40rem"
    }
  },
  "motion": {
    "duration": {
      "fade": {
        "$type": "duration",
        "$value": {
          "unit": "ms",
          "value": 150
        }
      },
      "move": {
        "$type": "duration",
        "$value": {
          "unit": "ms",
          "value": 250
        }
      },
      "none": {
        "$type": "duration",
        "$value": {
          "unit": "ms",
          "value": 0
        }
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [0.4, 0, 0.2, 1]
      }
    }
  },
  "space": {
    "m": {
      "$type": "dimension",
      "$value": "16px"
    },
    "s": {
      "$type": "dimension",
      "$value": "8px"
    }
  }
}
