{
  "primitive": {
    "color": {
      "black": {
        "$type": "color",
        "$value": "oklch(0% 0 none)"
      },
      "coral": {
        "$type": "color",
        "$value": "oklch(68% 0.19 28)"
      },
      "cyan": {
        "$type": "color",
        "$value": "oklch(76% 0.13 210)"
      },
      "white": {
        "$type": "color",
        "$value": "oklch(100% 0 none)"
      }
    },
    "font": {
      "mono": {
        "$type": "fontFamily",
        "$value": "var(--font-mono, ui-monospace), monospace"
      },
      "sans": {
        "$type": "fontFamily",
        "$value": "system-ui, sans-serif"
      }
    },
    "grid": {
      "module": {
        "$type": "dimension",
        "$value": "0.25rem"
      }
    },
    "layout": {
      "sm": {
        "$type": "dimension",
        "$value": "{grid.module} * 160"
      },
      "md": {
        "$type": "dimension",
        "$value": "{grid.module} * 192"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{grid.module} * 256"
      },
      "xl": {
        "$type": "dimension",
        "$value": "{grid.module} * 320"
      }
    },
    "motion": {
      "duration": {
        "none": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 0
          }
        },
        "fade": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 150
          }
        },
        "move": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 250
          }
        },
        "breathe": {
          "$type": "duration",
          "$value": {
            "unit": "s",
            "value": 12
          }
        }
      },
      "easing": {
        "standard": {
          "$type": "cubicBezier",
          "$value": [0.4, 0, 0.2, 1]
        }
      }
    },
    "space": {
      "px": {
        "$type": "dimension",
        "$value": "1px"
      },
      "xxs": {
        "$type": "dimension",
        "$value": "{grid.module} * 0.5"
      },
      "xs": {
        "$type": "dimension",
        "$value": "{grid.module}"
      },
      "sm": {
        "$type": "dimension",
        "$value": "{grid.module} * 2"
      },
      "md": {
        "$type": "dimension",
        "$value": "{grid.module} * 4"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{grid.module} * 8"
      }
    }
  },
  "light": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.black}"
      },
      "split": {
        "$type": "color",
        "$value": "{color.coral}"
      },
      "splitPair": {
        "$type": "color",
        "$value": "{color.cyan}"
      }
    }
  },
  "dark": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{color.black}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "split": {
        "$type": "color",
        "$value": "{color.coral}"
      },
      "splitPair": {
        "$type": "color",
        "$value": "{color.cyan}"
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "primitive": "enabled",
        "dark": "disabled",
        "light": "enabled"
      }
    },
    {
      "id": "dark",
      "name": "dark",
      "selectedTokenSets": {
        "primitive": "enabled",
        "dark": "enabled",
        "light": "disabled"
      }
    }
  ],
  "$metadata": {
    "tokenSetOrder": ["primitive", "light", "dark"]
  }
}
