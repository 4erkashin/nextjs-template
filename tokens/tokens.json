{
  "primitive": {
    "color": {
      "black": {
        "$type": "color",
        "$value": "oklch(0 0 0)"
      },
      "night": {
        "$type": "color",
        "$value": "oklch(0.19 0.025 230)"
      },
      "ink": {
        "$type": "color",
        "$value": "oklch(0.18 0 0)"
      },
      "graphite": {
        "$type": "color",
        "$value": "oklch(0.35 0 0)"
      },
      "coral": {
        "$type": "color",
        "$value": "oklch(0.68 0.26 27)"
      },
      "cyan": {
        "$type": "color",
        "$value": "oklch(0.78 0.20 215)"
      },
      "mist": {
        "$type": "color",
        "$value": "oklch(0.82 0 0)"
      },
      "paper": {
        "$type": "color",
        "$value": "oklch(0.975 0.003 80)"
      },
      "line": {
        "$type": "color",
        "$value": "oklch(0.91 0 0)"
      },
      "fog": {
        "$type": "color",
        "$value": "oklch(1 0 0 / 0.12)"
      },
      "white": {
        "$type": "color",
        "$value": "oklch(1 0 0)"
      }
    },
    "font": {
      "mono": {
        "$type": "fontFamily",
        "$value": "var(--font-mono, ui-monospace), monospace"
      },
      "sans": {
        "$type": "fontFamily",
        "$value": "system-ui, sans-serif"
      }
    },
    "grid": {
      "module": {
        "$type": "dimension",
        "$value": "0.25rem"
      }
    },
    "layout": {
      "sm": {
        "$type": "dimension",
        "$value": "{grid.module} * 160"
      },
      "md": {
        "$type": "dimension",
        "$value": "{grid.module} * 192"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{grid.module} * 256"
      },
      "xl": {
        "$type": "dimension",
        "$value": "{grid.module} * 320"
      }
    },
    "motion": {
      "duration": {
        "none": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 0
          }
        },
        "fade": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 150
          }
        },
        "move": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 250
          }
        },
        "breathe": {
          "$type": "duration",
          "$value": {
            "unit": "s",
            "value": 12
          }
        }
      },
      "easing": {
        "standard": {
          "$type": "cubicBezier",
          "$value": [0.4, 0, 0.2, 1]
        }
      }
    },
    "space": {
      "px": {
        "$type": "dimension",
        "$value": "1px"
      },
      "xxs": {
        "$type": "dimension",
        "$value": "{grid.module} * 0.5"
      },
      "xs": {
        "$type": "dimension",
        "$value": "{grid.module}"
      },
      "sm": {
        "$type": "dimension",
        "$value": "{grid.module} * 2"
      },
      "md": {
        "$type": "dimension",
        "$value": "{grid.module} * 4"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{grid.module} * 8"
      }
    }
  },
  "light": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{color.paper}"
      },
      "card": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "cardForeground": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "primary": {
        "$type": "color",
        "$value": "{color.coral}"
      },
      "primaryForeground": {
        "$type": "color",
        "$value": "{color.black}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.black}"
      },
      "secondaryForeground": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.line}"
      },
      "mutedForeground": {
        "$type": "color",
        "$value": "{color.graphite}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "ring": {
        "$type": "color",
        "$value": "{color.coral}"
      },
      "glitch": {
        "$type": "color",
        "$value": "{color.cyan}"
      },
      "glitchPair": {
        "$type": "color",
        "$value": "{color.coral}"
      }
    }
  },
  "dark": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{color.night}"
      },
      "card": {
        "$type": "color",
        "$value": "{color.fog}"
      },
      "cardForeground": {
        "$type": "color",
        "$value": "{color.mist}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.mist}"
      },
      "primary": {
        "$type": "color",
        "$value": "{color.coral}"
      },
      "primaryForeground": {
        "$type": "color",
        "$value": "{color.black}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.fog}"
      },
      "secondaryForeground": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.fog}"
      },
      "mutedForeground": {
        "$type": "color",
        "$value": "{color.mist}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.fog}"
      },
      "ring": {
        "$type": "color",
        "$value": "{color.coral}"
      },
      "glitch": {
        "$type": "color",
        "$value": "{color.cyan}"
      },
      "glitchPair": {
        "$type": "color",
        "$value": "{color.coral}"
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "primitive": "enabled",
        "dark": "disabled",
        "light": "enabled"
      }
    },
    {
      "id": "dark",
      "name": "dark",
      "selectedTokenSets": {
        "primitive": "enabled",
        "dark": "enabled",
        "light": "disabled"
      }
    }
  ],
  "$metadata": {
    "tokenSetOrder": ["primitive", "light", "dark"]
  }
}
