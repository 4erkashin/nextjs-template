{
  "primitive": {
    "color": {
      "black": {
        "$type": "color",
        "$value": "oklch(0% 0 none)"
      },
      "citron": {
        "$type": "color",
        "$value": "oklch(95.509% 0.17361 117.19)"
      },
      "cyan": {
        "$type": "color",
        "$value": "oklch(87.54% 0.13807 203.61)"
      },
      "fern": {
        "$type": "color",
        "$value": "oklch(59.239% 0.0979 154.17)"
      },
      "foam": {
        "$type": "color",
        "$value": "oklch(94.167% 0.0916 157.52)"
      },
      "kelp": {
        "$type": "color",
        "$value": "oklch(42.694% 0.08415 152.82)"
      },
      "magenta": {
        "$type": "color",
        "$value": "oklch(66.512% 0.22782 11.902)"
      },
      "mint": {
        "$type": "color",
        "$value": "oklch(90.597% 0.15898 155.55)"
      },
      "olive": {
        "$type": "color",
        "$value": "oklch(38% 0.12 117.19)"
      },
      "pine": {
        "$type": "color",
        "$value": "oklch(29.812% 0.05452 151.28)"
      },
      "void": {
        "$type": "color",
        "$value": "oklch(12.885% 0.00855 157.12)"
      },
      "white": {
        "$type": "color",
        "$value": "oklch(100% 0 none)"
      }
    },
    "font": {
      "mono": {
        "$type": "fontFamily",
        "$value": "var(--font-mono, ui-monospace), monospace"
      },
      "sans": {
        "$type": "fontFamily",
        "$value": "system-ui, sans-serif"
      }
    },
    "grid": {
      "module": {
        "$type": "dimension",
        "$value": "0.25rem"
      }
    },
    "layout": {
      "sm": {
        "$type": "dimension",
        "$value": "{grid.module} * 160"
      },
      "md": {
        "$type": "dimension",
        "$value": "{grid.module} * 192"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{grid.module} * 256"
      },
      "xl": {
        "$type": "dimension",
        "$value": "{grid.module} * 320"
      }
    },
    "motion": {
      "duration": {
        "none": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 0
          }
        },
        "fade": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 150
          }
        },
        "move": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 250
          }
        },
        "breathe": {
          "$type": "duration",
          "$value": {
            "unit": "s",
            "value": 12
          }
        }
      },
      "easing": {
        "standard": {
          "$type": "cubicBezier",
          "$value": [0.4, 0, 0.2, 1]
        }
      }
    },
    "space": {
      "px": {
        "$type": "dimension",
        "$value": "1px"
      },
      "xxs": {
        "$type": "dimension",
        "$value": "{grid.module} * 0.5"
      },
      "xs": {
        "$type": "dimension",
        "$value": "{grid.module}"
      },
      "sm": {
        "$type": "dimension",
        "$value": "{grid.module} * 2"
      },
      "md": {
        "$type": "dimension",
        "$value": "{grid.module} * 4"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{grid.module} * 8"
      }
    }
  },
  "light": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.black}"
      }
    }
  },
  "dark": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{color.black}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.white}"
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "primitive": "enabled",
        "dark": "disabled",
        "light": "enabled"
      }
    },
    {
      "id": "dark",
      "name": "dark",
      "selectedTokenSets": {
        "primitive": "enabled",
        "dark": "enabled",
        "light": "disabled"
      }
    }
  ],
  "$metadata": {
    "tokenSetOrder": ["primitive", "light", "dark"]
  }
}
