{
  "primitive": {
    "color": {
      "mint": {
        "$type": "color",
        "$value": "#7cffb2"
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": "system-ui, sans-serif"
      },
      "size": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "sizeDisplay": {
        "$type": "dimension",
        "$value": "2.5rem"
      },
      "sizeLg": {
        "$type": "dimension",
        "$value": "1.25rem"
      }
    },
    "layout": {
      "wide": {
        "$type": "dimension",
        "$value": "40rem"
      }
    },
    "motion": {
      "duration": {
        "breathe": {
          "$type": "duration",
          "$value": {
            "unit": "s",
            "value": 12
          }
        },
        "fade": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 150
          }
        },
        "move": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 250
          }
        },
        "none": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 0
          }
        }
      },
      "easing": {
        "standard": {
          "$type": "cubicBezier",
          "$value": [0.4, 0, 0.2, 1]
        }
      }
    },
    "space": {
      "l": {
        "$type": "dimension",
        "$value": "40px"
      },
      "m": {
        "$type": "dimension",
        "$value": "16px"
      },
      "px": {
        "$type": "dimension",
        "$value": "1px"
      },
      "s": {
        "$type": "dimension",
        "$value": "8px"
      }
    }
  },
  "light": {
    "color": {
      "accent": {
        "$type": "color",
        "$value": "#9c3a28"
      },
      "bg": {
        "$type": "color",
        "$value": "#e4d8c4"
      },
      "decorativeAccent": {
        "$type": "color",
        "$value": "{color.mint}"
      },
      "muted": {
        "$type": "color",
        "$value": "#6b6358"
      },
      "text": {
        "$type": "color",
        "$value": "#1f1a14"
      }
    }
  },
  "dark": {
    "color": {
      "accent": {
        "$type": "color",
        "$value": "#c45c3e"
      },
      "bg": {
        "$type": "color",
        "$value": "#16140f"
      },
      "decorativeAccent": {
        "$type": "color",
        "$value": "{color.mint}"
      },
      "muted": {
        "$type": "color",
        "$value": "#8a8070"
      },
      "text": {
        "$type": "color",
        "$value": "#e8dcc4"
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "primitive": "enabled",
        "dark": "disabled",
        "light": "enabled"
      }
    },
    {
      "id": "dark",
      "name": "dark",
      "selectedTokenSets": {
        "primitive": "enabled",
        "dark": "enabled",
        "light": "disabled"
      }
    }
  ],
  "$metadata": {
    "tokenSetOrder": ["primitive", "light", "dark"]
  }
}
