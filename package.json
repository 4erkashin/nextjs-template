{
  "name": "nextjs-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm tokens:build && next dev",
    "build": "pnpm tokens:build && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:build": "node tokens/build.js",
    "typecheck": "pnpm tokens:build && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "storybook": "pnpm tokens:build && storybook dev -p 6006",
    "build-storybook": "pnpm tokens:build && storybook build"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "next": "16.3.3",
    "next-intl": "^4.14.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/eslint-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tokens-studio/sd-transforms": "^2.0.3",
    "@types/node": "^20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "autoprefixer": "^10.5.4",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-storybook": "^10.5.10",
    "lefthook": "^2.1.10",
    "modern-normalize": "^3.0.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "playwright": "latest",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "storybook": "^10.5.10",
    "storybook-next-intl": "^10.1.3",
    "style-dictionary": "^5.5.2",
    "typescript": "^5",
    "unplugin": "^2.3.11",
    "vite": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=24"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
