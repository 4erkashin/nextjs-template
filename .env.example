# Set to 0 to disable MSW.
# NEXT_PUBLIC_MSW=0

# Optional. When set, the home page links this URL.
# Leave it unset and that phrase stays plain text.
# STORYBOOK_URL=http://localhost:6006

# Set to the public origin when deploying so social preview image URLs
# point to your site. Local builds default to http://localhost:3000.
# SITE_URL=https://example.com
