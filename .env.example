# Set to 0 to disable MSW.
# NEXT_PUBLIC_MSW=0

# Optional. When set, the home page links this URL.
# Leave it unset and that phrase stays plain text.
# STORYBOOK_URL=http://localhost:6006

# Set to the production public origin so social preview image URLs
# point to your site. Vercel previews use their deployment URL, and
# local builds default to http://localhost:3000.
# SITE_URL=https://example.com
